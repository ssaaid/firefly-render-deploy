log:
  level: info

http:
  port: 5000
  address: 0.0.0.0

spi:
  enabled: true

# Gateway mode: this namespace has no multiparty.org/multiparty.node/contract
# block, so it talks directly to the chain through blockchain0 without the
# multi-party broadcast/batch-pinning features (which need a deployed BatchPin
# contract and all 4 plugin types -- database, blockchain, sharedstorage,
# dataexchange). Fine for proving core <-> evmconnect <-> besu connectivity;
# revisit once a BatchPin contract is deployed and multi-org flows are needed.
namespaces:
  default: ${FIREFLY_NAMESPACE}
  predefined:
    - name: ${FIREFLY_NAMESPACE}
      plugins:
        - database0
        - blockchain0

plugins:
  database:
    - name: database0
      type: postgres
      postgres:
        url: "${DATABASE_URL}"
        migrations:
          auto: true

  blockchain:
    - name: blockchain0
      type: ethereum
      ethereum:
        ethconnect:
          url: "${EVMCONNECT_URL}"
          topic: "0"
