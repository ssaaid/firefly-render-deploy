log:
  level: info

http:
  port: 5000
  address: 0.0.0.0

spi:
  enabled: true

ui:
  enabled: true
  path: /firefly/frontend

namespaces:
  default: ${FIREFLY_NAMESPACE}
  predefined:
    - name: ${FIREFLY_NAMESPACE}
      multiparty:
        enabled: true
        org:
          name: ${CORE_ORG_NAME}
          key: "${ORG_SIGNING_KEY}"
        node:
          name: ${CORE_NODE_NAME}
        contract:
          - location:
              address: "${BATCHPIN_CONTRACT_ADDRESS}"
            firstEvent: "0"
      plugins:
        - database0
        - blockchain0
        - dataexchange0
        - sharedstorage0

plugins:
  database:
    - name: database0
      type: postgres
      postgres:
        url: "${DATABASE_URL}"
        migrations:
          auto: true

  blockchain:
    - name: blockchain0
      type: ethereum
      ethereum:
        ethconnect:
          url: "${EVMCONNECT_URL}"
          topic: "0"

  dataexchange:
    - name: dataexchange0
      type: ffdx
      ffdx:
        url: "${DATAEXCHANGE_URL}"

  sharedstorage:
    - name: sharedstorage0
      type: ipfs
      ipfs:
        api:
          url: "${IPFS_API_URL}"
        gateway:
          url: "${IPFS_GATEWAY_URL}"
