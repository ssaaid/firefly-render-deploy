# Copy to .env for local docker-compose testing.
# On Render, set these as environment variables on each service in the dashboard
# (or via render.yaml envVars) instead of committing a .env file.

# --- Besu (single-validator IBFT2 chain bundled in services/besu) ---
# Private key matching the validator address baked into services/besu/genesis.json.
# Generated once for this deployment -- see README "Connecting to Besu" section
# for the actual value. NEVER commit a real value for this to git.
BESU_VALIDATOR_KEY=0x...

# --- Besu2 (a second, independent chain -- services/besu2, its own "besu2" namespace) ---
# Private key matching services/besu2/genesis.json's extraData -- a DIFFERENT key
# from BESU_VALIDATOR_KEY above. See README "A second, independent Besu chain".
BESU2_VALIDATOR_KEY=0x...

# --- Signer (holds the org's signing key; evmconnect forwards to it, never signs itself) ---
SIGNER_KEY=0x...

# --- Core ---
FIREFLY_NAMESPACE=default
# Defaults to http://localhost:5050 in docker-compose.yml. On Render, set this
# to the service's https://*.onrender.com URL after the first deploy, or the
# Swagger UI at /api embeds an unreachable http://0.0.0.0:5000/... spec URL.
CORE_PUBLIC_URL=http://localhost:5050
FIREFLY_ORG_NAME=org1
FIREFLY_NODE_NAME=node1
# The firefly-signer keystore address (printed when it generates the keystore).
ORG_SIGNING_KEY=0x...
# Set after deploying the BatchPin contract through the signer -- see README.
BATCHPIN_CONTRACT_ADDRESS=0x...

# --- Database (Render managed Postgres in prod, local postgres for compose) ---
DATABASE_URL=postgres://firefly:firefly@postgres:5432/firefly?sslmode=disable

# --- IPFS ---
IPFS_API_URL=http://ipfs:5001
IPFS_GATEWAY_URL=http://ipfs:8080

# --- Data Exchange ---
DATAEXCHANGE_URL=http://dataexchange:3000
